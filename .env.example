# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Recruitment service
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/intelligent_recruitment
DATABASE_USERNAME=recruitment
DATABASE_PASSWORD=recruitment_local
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=recruitment
RABBITMQ_PASSWORD=recruitment_local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=recruitment
S3_SECRET_KEY=recruitment_local
S3_BUCKET=resume-files
DEEPSEEK_API_KEY=
# 本地开发直接调用 DeepSeek；请仅使用获授权的测试数据。
DEEPSEEK_ALLOW_EXTERNAL_DATA=true
WEB_ORIGIN=http://localhost:3000
AUTH_SECURE_COOKIE=false
EXPOSE_MOCK_CODE=false
PLATFORM_ADMIN_KEY=phase2-local-admin

# Alipay page payment. Keys must be PKCS#8 / X.509 PEM (or Base64) values and must never be committed.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
RECHARGE_CREDIT_VALIDITY_DAYS=3650

# SMS verification code channel: local (development) or aliyun (production).
# The Aliyun template must define a variable named ${code}, for example: 您的验证码是${code}，5分钟内有效。
VERIFICATION_CODE_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
