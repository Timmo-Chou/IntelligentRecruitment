{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/ai-platform/policy-decision.schema.json",
  "title": "PolicyDecision",
  "description": "A deterministic decision made by the recruitment business service. AI Platform may execute only when decision is allow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_decision_id", "capability", "decision", "tenant_id", "actor_id", "evaluated_at", "policy_version"],
  "properties": {
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["allow", "require_user_confirmation", "deny"] },
    "capability": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "evaluated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": []
}
