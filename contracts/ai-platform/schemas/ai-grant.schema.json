{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.intelligentplatform.local/ai-platform/schemas/ai-grant.schema.json",
  "title": "AI Execution Grant",
  "description": "BOSS 签发、IR 转发、AIAgentPlatform 验签的已授权 AI 执行凭证。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_version",
    "grant_id",
    "issuer",
    "audience",
    "tenant_id",
    "actor_id",
    "task_id",
    "authorization_id",
    "reservation_id",
    "product_domain",
    "capability",
    "idempotency_key",
    "issued_at",
    "expires_at",
    "max_input_tokens",
    "max_output_tokens",
    "model",
    "tokenizer"
  ],
  "properties": {
    "grant_version": { "type": "string", "const": "v1" },
    "grant_id": { "type": "string", "format": "uuid" },
    "issuer": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "const": "AIAgentPlatform" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "actor_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "minLength": 1 },
    "authorization_id": { "type": "string", "format": "uuid" },
    "reservation_id": { "type": "string", "format": "uuid" },
    "product_domain": { "type": "string", "enum": ["RECRUITMENT", "OPEN_API"] },
    "capability": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "tokenizer": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "issued_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_input_tokens": { "type": "integer", "minimum": 0 },
    "max_output_tokens": { "type": "integer", "minimum": 0 },
    "policy_snapshot": { "type": "object", "additionalProperties": true }
  }
}
