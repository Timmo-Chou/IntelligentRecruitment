{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/ai-platform/skill-manifest.schema.json",
  "title": "SkillManifest",
  "description": "An AI Platform registry record. It is platform-owned configuration and is not an end-user authorization mechanism.",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "capability", "status", "execution_mode", "input_schema_ref", "output_schema_ref", "prompt_version", "model_policy_version", "allowed_tool_ids", "data_policy_version"],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,99}$" },
    "version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$" },
    "capability": { "enum": ["requirement_chat", "jd_generation", "resume_parsing", "screening_plan_generation", "candidate_screening", "interview_kit_generation", "task_assistance"] },
    "status": { "enum": ["draft", "active", "deprecated", "disabled"] },
    "execution_mode": { "enum": ["sync", "stream", "async"] },
    "input_schema_ref": { "type": "string", "format": "uri-reference" },
    "output_schema_ref": { "type": "string", "format": "uri-reference" },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "model_policy_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "allowed_tool_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,99}$" },
      "uniqueItems": true
    },
    "data_policy_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
  }
}
