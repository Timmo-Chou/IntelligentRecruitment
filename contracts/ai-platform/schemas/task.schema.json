{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/ai-platform/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ai_task_id", "business_task_id", "capability", "status", "progress", "accepted_at"],
  "properties": {
    "ai_task_id": { "type": "string", "minLength": 1 },
    "business_task_id": { "type": "string", "minLength": 1 },
    "capability": { "enum": ["requirement_chat", "jd_generation", "resume_parsing", "screening_plan_generation", "candidate_screening", "interview_kit_generation"] },
    "status": { "enum": ["queued", "running", "waiting_for_input", "partially_completed", "completed", "failed", "cancelled"] },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total", "percent"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "accepted_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "error": { "$ref": "./error.schema.json" }
  }
}

