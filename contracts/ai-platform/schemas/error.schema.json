{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/ai-platform/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "request_id"],
  "properties": {
    "code": {
      "description": "错误码，与 BOSS 对齐。复用 BOSS 已有码，AI 执行面特有码不加 AI_ 前缀。",
      "enum": [
        "UNAUTHENTICATED",
        "ACCESS_DENIED",
        "RATE_LIMIT_EXCEEDED",
        "MONTHLY_QUOTA_EXCEEDED",
        "IDEMPOTENCY_CONFLICT",
        "INVALID_ARGUMENT",
        "FILE_UNSUPPORTED",
        "PARSE_FAILED",
        "CONTENT_REJECTED",
        "TASK_NOT_FOUND",
        "PROVIDER_UNAVAILABLE",
        "REQUEST_TIMEOUT",
        "CONTRACT_INVALID",
        "INTERNAL_ERROR"
      ]
    },
    "message": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "details": { "type": "object" }
  }
}
